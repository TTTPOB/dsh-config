{
  "name": "dsh-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "render": "node scripts/dsh-config.mjs render",
    "check": "node scripts/dsh-config.mjs check",
    "doctor": "node scripts/dsh-config.mjs doctor",
    "update": "node scripts/dsh-config.mjs update",
    "test:installation": "node scripts/dsh-config.mjs test",
    "test": "node --test tests/*.test.mjs",
    "build:word": "vite build --configLoader runner --config plugins-src/word/vite.config.ts",
    "typecheck:word": "tsc -p plugins-src/word/tsconfig.json",
    "build:powerpoint": "vite build --configLoader runner --config plugins-src/powerpoint/vite.config.ts",
    "typecheck:powerpoint": "tsc -p plugins-src/powerpoint/tsconfig.json",
    "check:plugins": "node scripts/check-plugin-builds.mjs"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "nunjucks": "3.2.4",
    "typescript": "5.9.3",
    "vite": "8.0.0"
  }
}
