- id: web
  config:
    searchProvider: deepseek-official
    fetchProvider: firecrawl
- id: web-fetch-http
  disabled: true
- id: ui-settings-general
  config:
    welcomeNoticeVersion: 2026-08-13.1
- id: ui-conversation
  config:
    busyEnter: steer
- id: llm-deepseek
  config:
    models:
      - id: deepseek-flash
        name: DeepSeek-V41-Flash
        contextWindow: 1000000
        inputModalities:
          - text
          - image
        imagePixelBudget: 640000
        imageMaxBytes: 1048576
        systemPromptUpdate: in-history
- id: agent-loop
  config:
    maxParallelToolCalls: 2
- id: agent-preset-registry
  config:
    default: standard-ptc
    selectedDefault: standard-ptc
- id: agent-default-model
  config:
    provider: [[ effective.defaultModel.provider | quote ]]
    model: [[ effective.defaultModel.model | quote ]]
    reasoningEffort: [[ effective.defaultModel.reasoningEffort | quote ]]
[[ machine.webPrivate ]]
